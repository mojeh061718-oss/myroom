{
  "$ref": "#/definitions/job-event",
  "definitions": {
    "job-event": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stage"
            },
            "stage": {
              "type": "string",
              "enum": [
                "queued",
                "lidar-parse",
                "detect-segment",
                "depth-scale",
                "match-texture",
                "scene-assemble",
                "done"
              ]
            },
            "progress": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "stage",
            "progress"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "category": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "position": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false
            },
            "size": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "d": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "w",
                "d",
                "h"
              ],
              "additionalProperties": false
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "category",
            "label",
            "position",
            "size",
            "confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "warning"
            },
            "message": {
              "type": "string"
            },
            "wallLabel": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "message",
            "wallLabel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "done"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "succeeded",
                "partial",
                "failed"
              ]
            },
            "sceneId": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "type": "string",
              "enum": [
                "sketch",
                "photo",
                "lidar"
              ]
            }
          },
          "required": [
            "type",
            "status",
            "sceneId",
            "tier"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "error"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
