{
  "$ref": "#/definitions/room-plan",
  "definitions": {
    "room-plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "const": "m"
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "pattern": "^[A-Z]+$"
              },
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              },
              "thickness": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 0.5
              },
              "height": {
                "type": "number",
                "minimum": 2,
                "maximum": 6
              },
              "openings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "door",
                        "window"
                      ]
                    },
                    "offset": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sillHeight": {
                      "type": "number",
                      "minimum": 0
                    },
                    "headHeight": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "swing": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "left",
                            "right"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "offset",
                    "width",
                    "sillHeight",
                    "headHeight",
                    "swing"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "label",
              "start",
              "end",
              "thickness",
              "height",
              "openings"
            ],
            "additionalProperties": false
          }
        },
        "closed": {
          "type": "boolean"
        },
        "floorArea": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "drawn",
            "drawn+lidarRefined",
            "scan"
          ]
        },
        "curvedWalls": {
          "type": "null"
        },
        "roomGroups": {
          "type": "null"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "units",
        "vertices",
        "walls",
        "closed",
        "floorArea",
        "source",
        "curvedWalls",
        "roomGroups"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
