{
  "$ref": "#/definitions/placed-object",
  "definitions": {
    "placed-object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "shape": {
                  "type": "string"
                }
              },
              "required": [
                "category",
                "shape"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "importedAssetId": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "label": {
          "type": "string"
        },
        "support": {
          "type": "string",
          "enum": [
            "floor",
            "wall",
            "surface",
            "ceiling"
          ]
        },
        "wallId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parentObjectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        },
        "rotationY": {
          "type": "number"
        },
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "d": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "w",
            "d",
            "h"
          ],
          "additionalProperties": false
        },
        "materials": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "textureRef": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": {}
        },
        "collisionExempt": {
          "type": "boolean",
          "default": false
        },
        "recon": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sourcePhotoIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "runnerUpCatalogIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "lowConfidence": {
                  "type": "boolean"
                }
              },
              "required": [
                "confidence",
                "sourcePhotoIds",
                "runnerUpCatalogIds",
                "lowConfidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "catalogId",
        "placeholder",
        "label",
        "support",
        "wallId",
        "parentObjectId",
        "position",
        "rotationY",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
